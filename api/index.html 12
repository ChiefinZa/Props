<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>EdgeBoard – Live NBA Props</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--ink:#0f1720;--mute:#5d6b7a;--line:#e3e7ec;--acc:#0a8f5b;--accbg:#e2f5ec;--bad:#c93c3c;--badbg:#fbe9e9;--warn:#a8710a;--warnbg:#fbf1dc;--bar:#9fb0c2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1218;--card:#161d26;--ink:#e8edf2;--mute:#8d9bab;--line:#263140;--acc:#2fd391;--accbg:#12352a;--bad:#ff7b7b;--badbg:#3a1c1f;--warn:#f0b955;--warnbg:#3a2d12;--bar:#4a5b6f}}
:root[data-theme="dark"]{--bg:#0d1218;--card:#161d26;--ink:#e8edf2;--mute:#8d9bab;--line:#263140;--acc:#2fd391;--accbg:#12352a;--bad:#ff7b7b;--badbg:#3a1c1f;--warn:#f0b955;--warnbg:#3a2d12;--bar:#4a5b6f}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);background:var(--card);flex-wrap:wrap}
.logo{font-weight:800;font-size:20px;letter-spacing:-.02em}.logo b{color:var(--acc)}
.sub{color:var(--mute);font-size:13px}
button{font:inherit;cursor:pointer;color:inherit}
.theme{border:1px solid var(--line);background:none;border-radius:8px;padding:6px 10px}
main{max-width:1180px;margin:0 auto;padding:16px;display:grid;grid-template-columns:1fr 320px;gap:16px}
@media(max-width:900px){main{grid-template-columns:1fr}}
.notice{grid-column:1/-1;background:var(--warnbg);color:var(--warn);border-radius:10px;padding:10px 14px;font-size:13px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px}
.stat{background:var(--bg);border-radius:10px;padding:10px}.stat small{color:var(--mute);display:block;font-size:12px}.stat strong{font-size:20px}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.chip{border:1px solid var(--line);background:none;border-radius:999px;padding:5px 12px;font-size:13px}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
input[type=search],input[type=number]{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:8px;padding:6px 10px;font:inherit;min-width:0}
label.s{font-size:13px;color:var(--mute);display:flex;align-items:center;gap:6px}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:640px}
th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-size:12px;color:var(--mute);font-weight:600;cursor:pointer;user-select:none}
tr.row{cursor:pointer}tr.row:hover,tr.sel{background:var(--bg)}
.pn{font-weight:600}.pm{font-size:12px;color:var(--mute)}
.pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:700}
.over{background:var(--accbg);color:var(--acc)}.under{background:var(--badbg);color:var(--bad)}
.tier{font-weight:800}.tA{color:var(--acc)}.tB{color:var(--warn)}.tC{color:var(--mute)}
.add{border:1px solid var(--acc);color:var(--acc);background:none;border-radius:8px;padding:3px 10px;font-size:13px}
.add[disabled]{opacity:.5;cursor:default}
aside{display:flex;flex-direction:column;gap:16px}
h3{margin:0 0 8px;font-size:15px}
.bars{display:flex;align-items:flex-end;gap:5px;height:120px;position:relative;margin:10px 0 4px;padding-top:4px}
.bar{flex:1;background:var(--bar);border-radius:4px 4px 0 0;position:relative;min-height:2px}
.bar.hit{background:var(--acc)}
.bar span{position:absolute;top:-16px;left:0;right:0;text-align:center;font-size:10px;color:var(--mute)}
.lineh{position:absolute;left:0;right:0;border-top:2px dashed var(--warn)}
.kv{display:flex;justify-content:space-between;padding:4px 0;font-size:14px;border-bottom:1px dashed var(--line)}
.slipitem{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line);font-size:13px}
.x{border:none;background:none;color:var(--mute);font-size:16px}
.muted{color:var(--mute);font-size:13px}
.bdg{background:var(--warnbg);color:var(--warn);border-radius:6px;padding:1px 6px;font-size:11px;font-weight:700}
.bdg.bad{background:var(--badbg);color:var(--bad)}
.best{color:var(--acc);font-weight:700}
.hdr{display:flex;align-items:center;gap:12px}
.tabs{grid-column:1/-1;display:flex;gap:8px;flex-wrap:wrap}
.sp{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:3px 11px;font-size:12px;font-weight:700;margin:3px 6px 3px 0;text-align:left}
.sp .agree{font-weight:500;opacity:.85}
.sp.over{background:var(--accbg);color:var(--acc);border-color:transparent}.sp.under{background:var(--badbg);color:var(--bad);border-color:transparent}
.sbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
td.wrap{white-space:normal}
table.inj{min-width:0;margin-bottom:6px}
.st{font-weight:700;font-size:12px}.st-out{color:var(--bad)}.st-q{color:var(--warn)}.st-p{color:var(--mute)}
footer{max-width:1180px;margin:0 auto;padding:8px 16px 28px;color:var(--mute);font-size:12px}
</style>
</head>
<body>
<header>
  <div><div class="logo">Edge<b>Board</b></div><div class="sub">Player prop projections, hit rates and edge</div></div>
  <div class="hdr"><span class="sub" id="upd"></span><button class="theme" id="refresh" aria-label="Refresh data">Refresh</button><button class="theme" id="theme" aria-label="Toggle theme">Theme</button></div>
</header>
<main>
  <div class="notice">Loading live data…</div>
  <nav class="tabs" id="tabs" aria-label="Views">
    <button class="chip" data-v="board" aria-pressed="true">Board</button>
    <button class="chip" data-v="streaks" aria-pressed="false">Streaks</button>
    <button class="chip" data-v="inj" aria-pressed="false">Injuries</button>
  </nav>
  <section class="panel" id="vBoard">
    <div class="stats">
      <div class="stat"><small>Props shown</small><strong id="sCount">0</strong></div>
      <div class="stat"><small>Best edge</small><strong id="sBest">–</strong></div>
      <div class="stat"><small>Avg edge</small><strong id="sAvg">–</strong></div>
    </div>
    <div class="tools">
      <span id="chips"></span>
      <input type="search" id="q" placeholder="Search player or stat" aria-label="Search">
      <label class="s">Min edge <input type="number" id="minE" value="-10" min="-50" max="30" step="1" style="width:64px">pts</label>
      <label class="s"><input type="checkbox" id="useBest"> Use best price across books</label>
      <label class="s"><input type="checkbox" id="hideGap"> Hide big model/market gaps</label>
    </div>
    <div class="tw"><table>
      <thead><tr>
        <th data-k="name">Player</th><th data-k="stat">Prop</th><th>Guarded by</th><th data-k="line">Line</th><th data-k="dec">Odds</th><th data-k="proj">Proj</th>
        <th data-k="hit">L10 hit</th><th data-k="p">Model %</th><th data-k="edge">Edge ▾</th><th>Pick</th><th></th>
      </tr></thead>
      <tbody id="tb"></tbody>
    </table></div>
    <p class="muted" id="empty" hidden>No props match these filters.</p>
  </section>
  <section class="panel" id="vStreaks" hidden>
    <h3>Streaks</h3>
    <p class="muted">Players who have cleared a prop line in a row. A streak counts the games, newest first, that beat today's line on the same side, using the last 10 games. This uses today's line, not the lines the books posted in those games.</p>
    <div class="sbar">
      <span id="sChips"><button class="chip" data-ss="All" aria-pressed="true">All</button> <button class="chip" data-ss="Over" aria-pressed="false">Over</button> <button class="chip" data-ss="Under" aria-pressed="false">Under</button></span>
      <label class="s">Min streak <input type="number" id="sMin" value="3" min="2" max="10" step="1" style="width:60px"> games</label>
      <span class="muted" id="sCountS"></span>
    </div>
    <div class="tw"><table>
      <thead><tr><th>Player</th><th>Props on a streak (click one for its game chart)</th><th>Longest</th></tr></thead>
      <tbody id="sBody"></tbody>
    </table></div>
    <p class="muted" id="sEmpty" hidden>No streaks at this length. Lower the minimum streak.</p>
    <p class="muted">Streaks are a description of recent games, not a forecast. Past results only weakly predict the next game, so check the model's pick shown on each streak before leaning on it.</p>
  </section>
  <section class="panel" id="vInj" hidden>
    <h3>Injuries and lineup context</h3>
    <div id="injBody"></div>
  </section>
  <aside>
    <div class="panel" id="detail"><h3>Prop detail</h3><p class="muted">Select a row to see the last 10 games against the line.</p></div>
    <div class="panel">
      <h3>Slip builder</h3>
      <div id="slip"><p class="muted">Add picks to estimate a parlay.</p></div>
      <div id="slipCalc" hidden>
        <label class="s" style="margin:10px 0">Stake $ <input type="number" id="stake" value="10" min="1" step="1" style="width:80px"></label>
        <div class="kv"><span>Legs</span><b id="cLegs"></b></div>
        <div class="kv"><span>Payout multiple</span><b id="cMult"></b></div>
        <div class="kv"><span>Model hit chance</span><b id="cP"></b></div>
        <div class="kv"><span>Potential return</span><b id="cRet"></b></div>
        <div class="kv"><span>Expected value</span><b id="cEv"></b></div>
        <p class="muted">Uses each pick's real odds and the blended probabilities, and assumes independent outcomes. Same-game legs are usually correlated, so treat this as rough. Parlays multiply the sportsbook's margin, so expected value usually gets worse with more legs.</p>
        <button class="chip" id="clear">Clear slip</button>
      </div>
    </div>
  </aside>
</main>
<footer>How it works: base projection = 60% last-5 average + 40% last-10 average, then multiplied by four context factors (expected minutes/snaps, opponent pace, matchup strength, teammate-injury usage), capped at ±20% combined. Injuries come from ESPN's injury report: players listed Out are removed, and other flagged players get a badge, but the model does not price in the chance they sit out. Teammates listed Out (or Doubtful, counted at 75%) lift usage by about 0.3% per missing minute, scaled by the player's own minutes and capped at +10%; this is a rough estimate. Confirmed starting lineups are not included, so the minutes role shown is estimated from recent minutes. "Guarded by" is a position-and-minutes estimate of the likely defender, not a confirmed matchup, and it does not adjust the projection. Probability: a count-based model (negative binomial, which handles low numbers like threes better than a bell curve) built from the projection and a shrunk last-10 spread, then blended 35% model / 65% sportsbook no-vig price so a small sample cannot claim a huge edge. Edge = blended probability minus the break-even implied by the actual odds, in percentage points. Tiers: A ≥ 6, B ≥ 4, C ≥ 2, otherwise a lean. Most props show a negative edge because of the sportsbook's margin, and that is normal. Line shopping compares each prop across the sportsbooks The Odds API returns; "Use best price" calculates edges from the best price on each side at the shown line, so confirm the price on the book before betting. "Model vs market" flags props where the model and the sportsbook's no-vig probability differ by 20+ points: those are the most likely to be missing information such as lineup or role changes. This is a simple model, not a guarantee. Must be 21+ where legal. If gambling is a problem, call 1-800-GAMBLER.</footer>
<script>
const avg=a=>a.reduce((x,y)=>x+y,0)/a.length;
const dec=a=>a>0?1+a/100:1+100/-a;               // american -> decimal odds
const K={"Points":2.0,"Rebounds":1.4,"Assists":1.4,"3-Pointers":1.0}; // typical variance/mean by stat
const W=0.35;                                      // weight on our model vs the market's no-vig price
const sg=n=>(n>=0?"+":"\u2212")+Math.abs(n).toFixed(1);
const outN=p=>p.outMates.filter(x=>x.status==="Out"||x.status==="Doubtful");
const sp=a=>a==null?"\u2013":(a>0?"+"+a:String(a).replace("-","\u2212"));
function pmfs(mean,vr,n){
 const out=[];
 if(vr<=mean*1.0001){let p=Math.exp(-mean);out.push(p);for(let k=0;k<n;k++){p=p*mean/(k+1);out.push(p)}}
 else{const r=mean*mean/(vr-mean),q=r/(r+mean);let p=Math.exp(r*Math.log(q));out.push(p);for(let k=0;k<n;k++){p=p*(k+r)/(k+1)*(1-q);out.push(p)}}
 return out;
}
function overUnder(mean,vr,line){
 const fl=Math.floor(line),whole=fl===line;
 const pm=pmfs(mean,vr,fl);
 const cdf=u=>{let t=0;for(let k=0;k<=u&&k<pm.length;k++)t+=pm[k];return Math.min(t,1)};
 const under=whole?cdf(fl-1):cdf(fl);
 const push=whole?(pm[fl]||0):0;
 const over=Math.max(0,1-under-push),tot=over+under;
 return tot>0?{over:over/tot,under:under/tot}:{over:.5,under:.5};
}
function streakOf(g,line){
 const last=g[g.length-1];const side=last>line?"Over":last<line?"Under":null;
 if(!side)return{side:null,len:0};
 let n=0;for(let i=g.length-1;i>=0;i--){const v=g[i];if(side==="Over"?v>line:v<line)n++;else break}
 return{side,len:n};
}
const GAP=20;   // model vs market gap (percentage points) that triggers the warning
function build(RAW,useBest){return RAW.map((r,i)=>{
 const [sport,name,team,opp,stat,line,g,ctx,odds,extra,shopRaw]=r;
 const ex=extra||{},stk=streakOf(g,line);
 const a10=avg(g),a5=avg(g.slice(-5));
 const base=0.6*a5+0.4*a10;
 const [role,pace,dvp,inj,status]=ctx||[1,1,1,1,"Healthy"];
 const mult=Math.min(1.2,Math.max(0.8,role*pace*dvp*inj));
 const proj=base*mult;
 const mean=Math.max(proj,0.05);
 const sv=g.length>1?g.reduce((t,v)=>t+(v-a10)**2,0)/(g.length-1):0;
 const vr=Math.max(mean,0.5*sv+0.5*mean*(K[stat]||1.5));   // shrink the noisy 10-game spread toward a typical one
 const raw=overUnder(mean,vr,line);
 const pr=odds||[null,null];
 const oP=Number.isFinite(pr[0])?pr[0]:null,uP=Number.isFinite(pr[1])?pr[1]:null;
 const hasOdds=oP!=null&&uP!=null;
 let fairOver=0.5;
 if(hasOdds){const a=1/dec(oP),b=1/dec(uP);fairOver=a/(a+b)}  // remove the sportsbook's margin
 const bo=W*raw.over+(1-W)*fairOver;
 const shop=shopRaw||[],mainBook=ex.book||"";
 const gap=Math.abs(raw.over-fairOver)*100,bigGap=hasOdds&&gap>=GAP;
 const bestAt=k=>{let b=null;for(const x of shop){if(x.line!==line||x[k]==null)continue;if(!b||dec(x[k])>dec(b.price))b={price:x[k],book:x.book}}return b};
 const bestO=bestAt("over"),bestU=bestAt("under");
 const sides=[{side:"Over",p:bo,main:oP,best:bestO,raw:raw.over,fair:fairOver},{side:"Under",p:1-bo,main:uP,best:bestU,raw:raw.under,fair:1-fairOver}]
  .map(x=>{const useB=useBest&&x.best,price=useB?x.best.price:x.main,book=useB?x.best.book:mainBook;
   const d=dec(price==null?-110:price),be=1/d;return{...x,price,book,dec:d,be,ev:x.p*d-1,edge:(x.p-be)*100}});
 const b=sides[0].edge>=sides[1].edge?sides[0]:sides[1];
 const hits=g.filter(v=>b.side==="Over"?v>line:v<line).length;
 const tier=b.edge>=6?"A":b.edge>=4?"B":b.edge>=2?"C":"Lean";
 return{id:i,sport,name,team,opp,stat,line,g,base,mult,role,pace,dvp,inj,status,proj,sd:Math.sqrt(vr),side:b.side,p:b.p,praw:b.raw,fair:b.fair,price:b.price,dec:b.dec,be:b.be,ev:b.ev,edge:b.edge,tier,hasOdds,hit:hits,streakSide:stk.side,streakLen:stk.len,avgMin:ex.avgMin||null,minRole:ex.minRole||"",outMates:ex.outMates||[],injDetail:ex.injDetail||"",defenders:ex.defenders||[],pos:ex.pos||"",book:b.book,bestPrice:b.best?b.best.price:null,bestBook:b.best?b.best.book:"",shop,lineLo:shop.length?Math.min(...shop.map(x=>x.line)):line,lineHi:shop.length?Math.max(...shop.map(x=>x.line)):line,gap,bigGap};
});}
let props=[],rawRows=[];
let sport="All",sortK="edge",dir=-1,sel=null,slip=[];
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const f1=n=>n.toFixed(1);
function renderChips(){
 const ss=[...new Set(props.map(p=>p.sport))];sport="All";
 if(ss.length<2){$("chips").innerHTML=ss.length?`<span class="muted">${ss[0]} only</span>`:"";return}
 $("chips").innerHTML=["All",...ss].map(x=>`<button class="chip" data-s="${x}" aria-pressed="${x==="All"}">${x}</button>`).join(" ");
}
$("chips").onclick=e=>{const b=e.target.closest("[data-s]");if(!b)return;sport=b.dataset.s;
 document.querySelectorAll("#chips .chip").forEach(c=>c.setAttribute("aria-pressed",c.dataset.s===sport));render()};
$("q").oninput=render;$("minE").oninput=render;
document.querySelector("thead").onclick=e=>{const k=e.target.dataset&&e.target.dataset.k;if(!k)return;
 if(sortK===k)dir*=-1;else{sortK=k;dir=(k==="name"||k==="stat")?1:-1}render()};
function visible(){
 const q=$("q").value.trim().toLowerCase(),m=parseFloat($("minE").value);const mm=isNaN(m)?-99:m;
 return props.filter(p=>(sport==="All"||p.sport===sport)&&(!q||(p.name+" "+p.stat+" "+p.team).toLowerCase().includes(q))&&p.edge>=mm&&!($("hideGap").checked&&p.bigGap))
  .sort((a,b)=>{const x=a[sortK],y=b[sortK];return (typeof x==="string"?x.localeCompare(y):x-y)*dir});
}
function render(){
 const v=visible();
 $("sCount").textContent=v.length;
 $("sBest").textContent=v.length?sg(Math.max(...v.map(p=>p.edge)))+" pts":"–";
 $("sAvg").textContent=v.length?sg(avg(v.map(p=>p.edge)))+" pts":"–";
 $("empty").hidden=v.length>0;
 $("tb").innerHTML=v.map(p=>`<tr class="row ${sel===p.id?"sel":""}" data-id="${p.id}">
  <td><div class="pn">${esc(p.name)}</div><div class="pm">${p.sport} · ${p.team} vs ${p.opp}${p.status!=="Healthy"?` <span class="bdg">${esc(p.status)}</span>`:""}${outN(p).length?` <span class="bdg" title="${esc(outN(p).map(x=>x.player+" ("+x.status+")").join(", "))}">${outN(p).length} teammate${outN(p).length>1?"s":""} out</span>`:""}${p.bigGap?` <span class="bdg bad" title="The model and the sportsbook's no-vig price differ by ${f1(p.gap)} points. The market may know something the model does not.">model vs market ${Math.round(p.gap)} pts</span>`:""}${p.lineHi!==p.lineLo?` <span class="bdg" title="Sportsbooks disagree on this line">lines ${p.lineLo}\u2013${p.lineHi}</span>`:""}</div></td>
  <td>${esc(p.stat)}</td><td>${p.defenders.length?`${esc(p.defenders[0].name)} <span class="pm">${esc(p.defenders[0].pos)}</span>`:"\u2013"}</td><td>${p.line}</td><td>${p.price==null?"\u2212110*":sp(p.price)}${p.book?`<div class="pm">${esc(p.book)}</div>`:""}${p.bestPrice!=null&&p.price!=null&&dec(p.bestPrice)>dec(p.price)+1e-9?`<div class="pm best">best ${sp(p.bestPrice)} ${esc(p.bestBook)}</div>`:""}</td><td>${f1(p.proj)}</td>
  <td>${p.hit}/10</td><td>${f1(p.p*100)}%</td>
  <td><span class="tier t${p.tier==="A"?"A":p.tier==="B"?"B":"C"}">${sg(p.edge)} ${p.tier}</span></td>
  <td><span class="pill ${p.side==="Over"?"over":"under"}">${p.side} ${p.line}</span></td>
  <td><button class="add" data-add="${p.id}" ${slip.includes(p.id)?"disabled":""}>${slip.includes(p.id)?"Added":"+ Slip"}</button></td></tr>`).join("");
}
$("tb").onclick=e=>{
 const a=e.target.closest("[data-add]");
 if(a){const id=+a.dataset.add;if(!slip.includes(id))slip.push(id);renderSlip();render();return}
 const r=e.target.closest("tr.row");if(r){sel=+r.dataset.id;detail();render()}
};
function shopHtml(p){
 if(!p.shop.length)return "";
 const k=p.side.toLowerCase();
 const best=Math.max(0,...p.shop.filter(x=>x.line===p.line&&x[k]!=null).map(x=>dec(x[k])));
 const rows=p.shop.slice().sort((a,b)=>(b[k]!=null?dec(b[k]):0)-(a[k]!=null?dec(a[k]):0));
 const cell=(x,key)=>x[key]==null?"\u2013":sp(x[key]);
 return `<div class="muted" style="margin-top:10px"><b>Line shopping</b> (best ${k} price first)</div><div class="tw"><table class="inj"><tr><th>Book</th><th>Line</th><th>Over</th><th>Under</th></tr>${rows.map(x=>`<tr><td>${esc(x.book)}</td><td>${x.line}</td><td class="${k==="over"&&x.line===p.line&&x.over!=null&&dec(x.over)===best?"best":""}">${cell(x,"over")}</td><td class="${k==="under"&&x.line===p.line&&x.under!=null&&dec(x.under)===best?"best":""}">${cell(x,"under")}</td></tr>`).join("")}</table></div>${p.lineHi!==p.lineLo?`<p class="muted">Books disagree on the line (${p.lineLo} to ${p.lineHi}). Only prices at ${p.line} are compared above.</p>`:""}`;
}
function detail(){
 const p=props[sel];if(!p)return;
 const mx=Math.max(...p.g,p.line)*1.12,H=120;
 const bars=p.g.map((v,i)=>{const hit=p.side==="Over"?v>p.line:v<p.line;
  return `<div class="bar ${hit?"hit":""}" style="height:${v/mx*H}px" title="Game ${i+1}: ${v}"><span>${v}</span></div>`}).join("");
 $("detail").innerHTML=`<h3>${esc(p.name)} · ${esc(p.stat)}</h3>
  <div class="pm">${p.team} vs ${p.opp} · oldest → newest</div>
  <div class="bars">${bars}<div class="lineh" style="bottom:${p.line/mx*H}px"></div></div>
  <div class="muted">Dashed line = ${p.line}. Green bars cleared the ${p.side.toLowerCase()} side.</div>
  <div style="margin-top:10px">
  <div class="kv"><span>Model pick</span><b>${p.side} ${p.line}</b></div>
  <div class="kv"><span>Base projection</span><b>${f1(p.base)}</b></div><div class="kv"><span>Opportunity (minutes/snaps)</span><b>×${p.role.toFixed(2)}</b></div><div class="kv"><span>Opponent pace</span><b>×${p.pace.toFixed(2)}</b></div><div class="kv"><span>Matchup (defense)</span><b>×${p.dvp.toFixed(2)}</b></div><div class="kv"><span>Teammate injuries (usage)</span><b>×${p.inj.toFixed(2)}</b></div><div class="kv"><span>Adjusted projection</span><b>${f1(p.proj)}</b></div>${p.status!=="Healthy"?`<div class="kv"><span>Player status</span><b>${esc(p.status)}</b></div>${p.injDetail?`<p class="muted">${esc(p.injDetail)}</p>`:""}`:""}${p.defenders.length?`<div class="kv"><span>Likely defender${p.defenders.length>1?"s":""}</span><b>${esc(p.defenders.map(x=>x.name+" ("+x.pos+", "+x.min+" min)").join(", "))}</b></div><p class="muted">Estimate only: the opposing rotation player at the closest position${p.pos?" to "+esc(p.pos):""} with the most minutes, excluding anyone listed out. Real assignments vary and switch.</p>`:""}${p.avgMin?`<div class="kv"><span>Minutes role</span><b>${esc(p.minRole)} (${p.avgMin} min)</b></div>`:""}${outN(p).length?`<div class="kv"><span>Teammates out</span><b>${esc(outN(p).map(x=>x.player+(x.min?" ("+x.min+" min)":"")).join(", "))}</b></div>`:""}
  <div class="kv"><span>Last 10 avg / last 5 avg</span><b>${f1(avg(p.g))} / ${f1(avg(p.g.slice(-5)))}</b></div>
  <div class="kv"><span>Model spread (shrunk)</span><b>${f1(p.sd)}</b></div>
  <div class="kv"><span>Book odds (${p.side.toLowerCase()})</span><b>${p.price==null?"\u2212110 (est.)":sp(p.price)}</b></div>
  <div class="kv"><span>Break-even at those odds</span><b>${f1(p.be*100)}%</b></div>
  <div class="kv"><span>Market probability (no vig)</span><b>${f1(p.fair*100)}%</b></div>
  <div class="kv"><span>Raw model probability</span><b>${f1(p.praw*100)}%</b></div>
  <div class="kv"><span>Blended probability</span><b>${f1(p.p*100)}%</b></div>
  <div class="kv"><span>Expected value per $1</span><b>${p.ev>=0?"+":"\u2212"}$${Math.abs(p.ev).toFixed(2)}</b></div>
  <div class="kv"><span>Edge vs break-even</span><b>${sg(p.edge)} pts</b></div>
  <div class="kv"><span>Model vs market gap</span><b>${f1(p.gap)} pts</b></div>${p.bigGap?`<p class="muted"><b>Large gap.</b> The model disagrees sharply with the sportsbook's own price. That usually means the market knows something the model does not (lineup, role or minutes changes). Check the news before trusting this pick.</p>`:""}${p.bestPrice!=null?`<div class="kv"><span>Best ${p.side.toLowerCase()} price at ${p.line}</span><b>${sp(p.bestPrice)} (${esc(p.bestBook)})</b></div>`:""}${shopHtml(p)}
  ${p.hasOdds?"":`<p class="muted">No two-way odds came back for this prop, so \u2212110 on both sides is assumed.</p>`}</div>`;
}
function renderSlip(){
 const items=slip.map(id=>props[id]);
 $("slip").innerHTML=items.length?items.map(p=>`<div class="slipitem"><span><b>${esc(p.name)}</b><br><span class="muted">${p.side} ${p.line} ${esc(p.stat)} · ${p.price==null?"\u2212110":sp(p.price)} · ${f1(p.p*100)}%</span></span><button class="x" data-rm="${p.id}" aria-label="Remove">✕</button></div>`).join(""):`<p class="muted">Add picks to estimate a parlay.</p>`;
 $("slipCalc").hidden=!items.length;
 if(items.length)calc();
}
function calc(){
 const n=slip.length,st=Math.max(parseFloat($("stake").value)||0,0);
 const mult=slip.reduce((a,id)=>a*props[id].dec,1),p=slip.reduce((a,id)=>a*props[id].p,1);
 const ret=st*mult,ev=p*ret-st;
 $("cLegs").textContent=n;$("cMult").textContent=mult.toFixed(2)+"x";
 $("cP").textContent=(p*100).toFixed(1)+"%";$("cRet").textContent="$"+ret.toFixed(2);
 $("cEv").textContent=(ev>=0?"+$":"−$")+Math.abs(ev).toFixed(2);
 $("cEv").style.color=ev>=0?"var(--acc)":"var(--bad)";
}
$("stake").oninput=()=>slip.length&&calc();
$("slip").onclick=e=>{const b=e.target.closest("[data-rm]");if(!b)return;slip=slip.filter(i=>i!==+b.dataset.rm);renderSlip();render()};
$("clear").onclick=()=>{slip=[];renderSlip();render()};
$("theme").onclick=()=>{const d=document.documentElement,dark=getComputedStyle(d).getPropertyValue("--bg").trim()==="#0d1218";
 d.dataset.theme=dark?"light":"dark"};
const VIEWS={board:"vBoard",streaks:"vStreaks",inj:"vInj"};
$("tabs").onclick=e=>{const b=e.target.closest("[data-v]");if(!b)return;
 for(const k in VIEWS)$(VIEWS[k]).hidden=k!==b.dataset.v;
 document.querySelectorAll("#tabs .chip").forEach(c=>c.setAttribute("aria-pressed",c.dataset.v===b.dataset.v))};

let sSide="All";
function renderStreaks(){
 const min=Math.max(2,parseInt($("sMin").value,10)||3);
 const rows=props.filter(p=>p.streakLen>=min&&(sSide==="All"||p.streakSide===sSide));
 const by={};for(const p of rows){(by[p.name]=by[p.name]||[]).push(p)}
 const list=Object.values(by).map(a=>{a.sort((x,y)=>y.streakLen-x.streakLen||y.edge-x.edge);return{p:a[0],items:a,best:a[0].streakLen}})
  .sort((x,y)=>y.best-x.best||y.items.length-x.items.length);
 $("sCountS").textContent=list.length+" player"+(list.length===1?"":"s")+" · "+rows.length+" streak"+(rows.length===1?"":"s");
 $("sEmpty").hidden=list.length>0;
 const len=x=>x.streakLen>=x.g.length?x.g.length+"+":x.streakLen;
 $("sBody").innerHTML=list.map(({p,items})=>`<tr><td><div class="pn">${esc(p.name)}</div><div class="pm">${esc(p.team)} vs ${esc(p.opp)}</div></td><td class="wrap">${items.map(x=>`<button class="sp ${x.streakSide==="Over"?"over":"under"}" data-sel="${x.id}" title="Last 10 games: ${x.g.join(", ")}">${esc(x.stat)} ${x.streakSide} ${x.line} · ${len(x)} straight<span class="agree">${x.side===x.streakSide?" · model agrees":" · model leans "+x.side}</span></button>`).join("")}</td><td><b>${len(p)}</b></td></tr>`).join("");
}
$("sChips").onclick=e=>{const b=e.target.closest("[data-ss]");if(!b)return;sSide=b.dataset.ss;
 document.querySelectorAll("#sChips .chip").forEach(c=>c.setAttribute("aria-pressed",c.dataset.ss===sSide));renderStreaks()};
$("sMin").oninput=renderStreaks;
$("sBody").onclick=e=>{const b=e.target.closest("[data-sel]");if(!b)return;sel=+b.dataset.sel;detail();render()};

let injData={games:[],injuries:[],injuryError:null,updated:null};
const normT=t=>String(t||"").toLowerCase().replace(/[^a-z ]/g,"").trim();
const sameT=(a,b)=>{const x=normT(a),y=normT(b);return !!x&&!!y&&(x===y||x.split(" ").pop()===y.split(" ").pop())};
const ORD={"Out":0,"Doubtful":1,"Questionable":2,"Day-To-Day":3,"Probable":4};
const stc=t=>t==="Out"?"st-out":t==="Probable"?"st-p":"st-q";
function renderInj(){
 const d=injData;let h="";
 if(d.injuryError)h+=`<p class="notice">The injury feed could not be loaded (${esc(d.injuryError)}). Statuses and teammate-out adjustments are unavailable until it works.</p>`;
 if(!d.games.length)h+=`<p class="muted">No upcoming games loaded.</p>`;
 for(const gm of d.games){
  h+=`<h3 style="margin-top:14px">${esc(gm.away)} at ${esc(gm.home)}</h3>`;
  for(const team of [gm.away,gm.home]){
   const list=d.injuries.filter(x=>sameT(x.team,team)).sort((a,b)=>(ORD[a.status]??9)-(ORD[b.status]??9));
   h+=`<div class="pm" style="margin:8px 0 2px"><b>${esc(team)}</b></div>`;
   h+=list.length?`<div class="tw"><table class="inj"><tbody>${list.map(x=>`<tr><td class="pn">${esc(x.player)}</td><td><span class="st ${stc(x.status)}">${esc(x.status)}</span></td><td>${x.min?x.min+" min":""}</td><td class="wrap">${esc(x.detail)}</td></tr>`).join("")}</tbody></table></div>`:`<p class="muted">No injuries reported.</p>`;
  }
 }
 h+=`<p class="muted" style="margin-top:14px">Source: ESPN's injury report${d.updated?", loaded "+esc(new Date(d.updated).toLocaleTimeString()):""}. Reports change close to tip-off, so recheck before betting. Confirmed starting lineups are not included: free sources I could verify do not provide them. Each prop's detail panel shows an estimated minutes role instead (starter-level, rotation or bench), based on the player's last 5 games.</p>`;
 $("injBody").innerHTML=h;
}

function rebuild(){props=build(rawRows,$("useBest").checked);render();renderStreaks();if(sel!=null&&props[sel])detail();renderSlip()}
$("useBest").onchange=rebuild;
$("hideGap").onchange=render;
$("refresh").onclick=()=>load();
function updAge(){
 const el=$("upd"),t=injData.updated?Date.parse(injData.updated):NaN;
 if(!Number.isFinite(t)){el.textContent="";return}
 const m=Math.max(0,Math.round((Date.now()-t)/60000));
 el.textContent="Updated "+(m<1?"just now":m<60?m+" min ago":Math.floor(m/60)+" h "+(m%60)+" min ago");
 el.style.color=m>90?"var(--warn)":"";
}
setInterval(updAge,30000);

async function load(){
 const n=document.querySelector(".notice");
 n.textContent="Refreshing\u2026";
 try{
  const r=await fetch("/api/props");
  const raw=await r.json();
  const arr=Array.isArray(raw)?raw:(raw&&raw.props);
  if(!r.ok||!Array.isArray(arr))throw new Error((raw&&raw.error)||("HTTP "+r.status));
  if(!Array.isArray(raw))injData={games:raw.games||[],injuries:raw.injuries||[],injuryError:raw.injuryError||null,updated:raw.updated||null};
  rawRows=arr;props=build(arr,$("useBest").checked);
  renderChips();
  n.textContent=props.length?"Live data: lines and odds from The Odds API, game logs and injury reports from ESPN. Pace and matchup factors are still neutral, and teammate-injury adjustments are small estimates. Edges are model estimates, shrunk toward the market price, and are not betting advice.":"Connected, but no props came back (no games or lines available right now).";
 }catch(e){props=[];n.textContent="Could not load live data: "+e.message}
 render();renderStreaks();renderInj();updAge();
 if(props.length){sel=props.slice().sort((a,b)=>b.edge-a.edge)[0].id;detail();render()}
}
load();
</script>
</body>
</html>
