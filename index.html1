<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>EdgeBoard – Live NBA Props</title>
<style>
:root{--bg:#f6f7f9;--card:#fff;--ink:#0f1720;--mute:#5d6b7a;--line:#e3e7ec;--acc:#0a8f5b;--accbg:#e2f5ec;--bad:#c93c3c;--badbg:#fbe9e9;--warn:#a8710a;--warnbg:#fbf1dc;--bar:#9fb0c2;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0d1218;--card:#161d26;--ink:#e8edf2;--mute:#8d9bab;--line:#263140;--acc:#2fd391;--accbg:#12352a;--bad:#ff7b7b;--badbg:#3a1c1f;--warn:#f0b955;--warnbg:#3a2d12;--bar:#4a5b6f}}
:root[data-theme="dark"]{--bg:#0d1218;--card:#161d26;--ink:#e8edf2;--mute:#8d9bab;--line:#263140;--acc:#2fd391;--accbg:#12352a;--bad:#ff7b7b;--badbg:#3a1c1f;--warn:#f0b955;--warnbg:#3a2d12;--bar:#4a5b6f}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px;border-bottom:1px solid var(--line);background:var(--card);flex-wrap:wrap}
.logo{font-weight:800;font-size:20px;letter-spacing:-.02em}.logo b{color:var(--acc)}
.sub{color:var(--mute);font-size:13px}
button{font:inherit;cursor:pointer;color:inherit}
.theme{border:1px solid var(--line);background:none;border-radius:8px;padding:6px 10px}
main{max-width:1180px;margin:0 auto;padding:16px;display:grid;grid-template-columns:1fr 320px;gap:16px}
@media(max-width:900px){main{grid-template-columns:1fr}}
.notice{grid-column:1/-1;background:var(--warnbg);color:var(--warn);border-radius:10px;padding:10px 14px;font-size:13px}
.panel{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:14px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:12px}
.stat{background:var(--bg);border-radius:10px;padding:10px}.stat small{color:var(--mute);display:block;font-size:12px}.stat strong{font-size:20px}
.tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:12px}
.chip{border:1px solid var(--line);background:none;border-radius:999px;padding:5px 12px;font-size:13px}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--bg);border-color:var(--ink)}
input[type=search],input[type=number]{border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:8px;padding:6px 10px;font:inherit;min-width:0}
label.s{font-size:13px;color:var(--mute);display:flex;align-items:center;gap:6px}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:640px}
th,td{text-align:left;padding:9px 8px;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-size:12px;color:var(--mute);font-weight:600;cursor:pointer;user-select:none}
tr.row{cursor:pointer}tr.row:hover,tr.sel{background:var(--bg)}
.pn{font-weight:600}.pm{font-size:12px;color:var(--mute)}
.pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;font-weight:700}
.over{background:var(--accbg);color:var(--acc)}.under{background:var(--badbg);color:var(--bad)}
.tier{font-weight:800}.tA{color:var(--acc)}.tB{color:var(--warn)}.tC{color:var(--mute)}
.add{border:1px solid var(--acc);color:var(--acc);background:none;border-radius:8px;padding:3px 10px;font-size:13px}
.add[disabled]{opacity:.5;cursor:default}
aside{display:flex;flex-direction:column;gap:16px}
h3{margin:0 0 8px;font-size:15px}
.bars{display:flex;align-items:flex-end;gap:5px;height:120px;position:relative;margin:10px 0 4px;padding-top:4px}
.bar{flex:1;background:var(--bar);border-radius:4px 4px 0 0;position:relative;min-height:2px}
.bar.hit{background:var(--acc)}
.bar span{position:absolute;top:-16px;left:0;right:0;text-align:center;font-size:10px;color:var(--mute)}
.lineh{position:absolute;left:0;right:0;border-top:2px dashed var(--warn)}
.kv{display:flex;justify-content:space-between;padding:4px 0;font-size:14px;border-bottom:1px dashed var(--line)}
.slipitem{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--line);font-size:13px}
.x{border:none;background:none;color:var(--mute);font-size:16px}
.muted{color:var(--mute);font-size:13px}
.bdg{background:var(--warnbg);color:var(--warn);border-radius:6px;padding:1px 6px;font-size:11px;font-weight:700}
footer{max-width:1180px;margin:0 auto;padding:8px 16px 28px;color:var(--mute);font-size:12px}
</style>
</head>
<body>
<header>
  <div><div class="logo">Edge<b>Board</b></div><div class="sub">Player prop projections, hit rates and edge</div></div>
  <button class="theme" id="theme" aria-label="Toggle theme">Theme</button>
</header>
<main>
  <div class="notice">Loading live data…</div>
  <section class="panel">
    <div class="stats">
      <div class="stat"><small>Props shown</small><strong id="sCount">0</strong></div>
      <div class="stat"><small>Best edge</small><strong id="sBest">–</strong></div>
      <div class="stat"><small>Avg edge</small><strong id="sAvg">–</strong></div>
    </div>
    <div class="tools">
      <span id="chips"></span>
      <input type="search" id="q" placeholder="Search player or stat" aria-label="Search">
      <label class="s">Min edge <input type="number" id="minE" value="0" min="-5" max="30" step="1" style="width:64px">%</label>
    </div>
    <div class="tw"><table>
      <thead><tr>
        <th data-k="name">Player</th><th data-k="stat">Prop</th><th data-k="line">Line</th><th data-k="proj">Proj</th>
        <th data-k="hit">L10 hit</th><th data-k="p">Model %</th><th data-k="edge">Edge ▾</th><th>Pick</th><th></th>
      </tr></thead>
      <tbody id="tb"></tbody>
    </table></div>
    <p class="muted" id="empty" hidden>No props match these filters.</p>
  </section>
  <aside>
    <div class="panel" id="detail"><h3>Prop detail</h3><p class="muted">Select a row to see the last 10 games against the line.</p></div>
    <div class="panel">
      <h3>Slip builder</h3>
      <div id="slip"><p class="muted">Add picks to estimate a parlay.</p></div>
      <div id="slipCalc" hidden>
        <label class="s" style="margin:10px 0">Stake $ <input type="number" id="stake" value="10" min="1" step="1" style="width:80px"></label>
        <div class="kv"><span>Legs</span><b id="cLegs"></b></div>
        <div class="kv"><span>Payout multiple</span><b id="cMult"></b></div>
        <div class="kv"><span>Model hit chance</span><b id="cP"></b></div>
        <div class="kv"><span>Potential return</span><b id="cRet"></b></div>
        <div class="kv"><span>Expected value</span><b id="cEv"></b></div>
        <p class="muted">Assumes −110 on every leg and independent outcomes. Same-game legs are usually correlated, so treat this as rough.</p>
        <button class="chip" id="clear">Clear slip</button>
      </div>
    </div>
  </aside>
</main>
<footer>How it works: base projection = 60% last-5 average + 40% last-10 average, then multiplied by four context factors (expected minutes/snaps, opponent pace, matchup strength, teammate-injury usage), capped at ±20% combined. Questionable or probable players are flagged, but the model does not price in the chance they sit out. Model % is a normal-distribution estimate using the last-10 spread. Edge = model % minus the 52.4% break-even needed at −110. Tiers: A ≥ 12%, B ≥ 7%, C ≥ 3%, below that is a lean. This is a simple model, not a guarantee. Must be 21+ where legal. If gambling is a problem, call 1-800-GAMBLER.</footer>
<script>
const BE=1/1.909091;
const avg=a=>a.reduce((x,y)=>x+y,0)/a.length;
function erf(x){const s=x<0?-1:1;x=Math.abs(x);const t=1/(1+0.3275911*x);
 const y=1-(((((1.061405429*t-1.453152027)*t)+1.421413741)*t-0.284496736)*t+0.254829592)*t*Math.exp(-x*x);return s*y}
const Phi=z=>0.5*(1+erf(z/Math.SQRT2));
function build(RAW){return RAW.map((r,i)=>{
 const [sport,name,team,opp,stat,line,g,ctx]=r;
 const a10=avg(g),a5=avg(g.slice(-5));
 const base=0.6*a5+0.4*a10;
 const [role,pace,dvp,inj,status]=ctx||[1,1,1,1,"Healthy"];
 const mult=Math.min(1.2,Math.max(0.8,role*pace*dvp*inj));
 const proj=base*mult;
 const sd=Math.max(Math.sqrt(g.reduce((s,v)=>s+(v-a10)**2,0)/(g.length-1))*mult,0.5);
 const pOver=1-Phi((line-proj)/sd);
 const side=proj>line?"Over":"Under";
 const p=side==="Over"?pOver:1-pOver;
 const hits=g.filter(v=>side==="Over"?v>line:v<line).length;
 const edge=(p-BE)*100;
 const tier=edge>=12?"A":edge>=7?"B":edge>=3?"C":"Lean";
 return{id:i,sport,name,team,opp,stat,line,g,base,mult,role,pace,dvp,inj,status,proj,sd,side,p,hit:hits,edge,tier};
});}
let props=[];
let sport="All",sortK="edge",dir=-1,sel=null,slip=[];
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const f1=n=>n.toFixed(1);
$("chips").innerHTML=["All","NBA","NFL","MLB","NHL"].map(s=>`<button class="chip" data-s="${s}" aria-pressed="${s==="All"}">${s}</button>`).join(" ");
$("chips").onclick=e=>{const b=e.target.closest("[data-s]");if(!b)return;sport=b.dataset.s;
 document.querySelectorAll("#chips .chip").forEach(c=>c.setAttribute("aria-pressed",c.dataset.s===sport));render()};
$("q").oninput=render;$("minE").oninput=render;
document.querySelector("thead").onclick=e=>{const k=e.target.dataset&&e.target.dataset.k;if(!k)return;
 if(sortK===k)dir*=-1;else{sortK=k;dir=(k==="name"||k==="stat")?1:-1}render()};
function visible(){
 const q=$("q").value.trim().toLowerCase(),m=parseFloat($("minE").value);const mm=isNaN(m)?-99:m;
 return props.filter(p=>(sport==="All"||p.sport===sport)&&(!q||(p.name+" "+p.stat+" "+p.team).toLowerCase().includes(q))&&p.edge>=mm)
  .sort((a,b)=>{const x=a[sortK],y=b[sortK];return (typeof x==="string"?x.localeCompare(y):x-y)*dir});
}
function render(){
 const v=visible();
 $("sCount").textContent=v.length;
 $("sBest").textContent=v.length?"+"+f1(Math.max(...v.map(p=>p.edge)))+"%":"–";
 $("sAvg").textContent=v.length?f1(avg(v.map(p=>p.edge)))+"%":"–";
 $("empty").hidden=v.length>0;
 $("tb").innerHTML=v.map(p=>`<tr class="row ${sel===p.id?"sel":""}" data-id="${p.id}">
  <td><div class="pn">${esc(p.name)}</div><div class="pm">${p.sport} · ${p.team} vs ${p.opp}${p.status!=="Healthy"?` <span class="bdg">${p.status}</span>`:""}</div></td>
  <td>${esc(p.stat)}</td><td>${p.line}</td><td>${f1(p.proj)}</td>
  <td>${p.hit}/10</td><td>${f1(p.p*100)}%</td>
  <td><span class="tier t${p.tier==="A"?"A":p.tier==="B"?"B":"C"}">${f1(p.edge)}% ${p.tier}</span></td>
  <td><span class="pill ${p.side==="Over"?"over":"under"}">${p.side} ${p.line}</span></td>
  <td><button class="add" data-add="${p.id}" ${slip.includes(p.id)?"disabled":""}>${slip.includes(p.id)?"Added":"+ Slip"}</button></td></tr>`).join("");
}
$("tb").onclick=e=>{
 const a=e.target.closest("[data-add]");
 if(a){const id=+a.dataset.add;if(!slip.includes(id))slip.push(id);renderSlip();render();return}
 const r=e.target.closest("tr.row");if(r){sel=+r.dataset.id;detail();render()}
};
function detail(){
 const p=props[sel];if(!p)return;
 const mx=Math.max(...p.g,p.line)*1.12,H=120;
 const bars=p.g.map((v,i)=>{const hit=p.side==="Over"?v>p.line:v<p.line;
  return `<div class="bar ${hit?"hit":""}" style="height:${v/mx*H}px" title="Game ${i+1}: ${v}"><span>${v}</span></div>`}).join("");
 $("detail").innerHTML=`<h3>${esc(p.name)} · ${esc(p.stat)}</h3>
  <div class="pm">${p.team} vs ${p.opp} · oldest → newest</div>
  <div class="bars">${bars}<div class="lineh" style="bottom:${p.line/mx*H}px"></div></div>
  <div class="muted">Dashed line = ${p.line}. Green bars cleared the ${p.side.toLowerCase()} side.</div>
  <div style="margin-top:10px">
  <div class="kv"><span>Model pick</span><b>${p.side} ${p.line}</b></div>
  <div class="kv"><span>Base projection</span><b>${f1(p.base)}</b></div><div class="kv"><span>Opportunity (minutes/snaps)</span><b>×${p.role.toFixed(2)}</b></div><div class="kv"><span>Opponent pace</span><b>×${p.pace.toFixed(2)}</b></div><div class="kv"><span>Matchup (defense)</span><b>×${p.dvp.toFixed(2)}</b></div><div class="kv"><span>Teammate injuries (usage)</span><b>×${p.inj.toFixed(2)}</b></div><div class="kv"><span>Adjusted projection</span><b>${f1(p.proj)}</b></div>${p.status!=="Healthy"?`<div class="kv"><span>Player status</span><b>${p.status}</b></div>`:""}
  <div class="kv"><span>Last 10 avg / last 5 avg</span><b>${f1(avg(p.g))} / ${f1(avg(p.g.slice(-5)))}</b></div>
  <div class="kv"><span>Std. deviation</span><b>${f1(p.sd)}</b></div>
  <div class="kv"><span>Model probability</span><b>${f1(p.p*100)}%</b></div>
  <div class="kv"><span>Edge vs −110</span><b>${f1(p.edge)}%</b></div></div>`;
}
function renderSlip(){
 const items=slip.map(id=>props[id]);
 $("slip").innerHTML=items.length?items.map(p=>`<div class="slipitem"><span><b>${esc(p.name)}</b><br><span class="muted">${p.side} ${p.line} ${esc(p.stat)} · ${f1(p.p*100)}%</span></span><button class="x" data-rm="${p.id}" aria-label="Remove">✕</button></div>`).join(""):`<p class="muted">Add picks to estimate a parlay.</p>`;
 $("slipCalc").hidden=!items.length;
 if(items.length)calc();
}
function calc(){
 const n=slip.length,st=Math.max(parseFloat($("stake").value)||0,0);
 const mult=Math.pow(1.909091,n),p=slip.reduce((a,id)=>a*props[id].p,1);
 const ret=st*mult,ev=p*ret-st;
 $("cLegs").textContent=n;$("cMult").textContent=mult.toFixed(2)+"x";
 $("cP").textContent=(p*100).toFixed(1)+"%";$("cRet").textContent="$"+ret.toFixed(2);
 $("cEv").textContent=(ev>=0?"+$":"−$")+Math.abs(ev).toFixed(2);
 $("cEv").style.color=ev>=0?"var(--acc)":"var(--bad)";
}
$("stake").oninput=()=>slip.length&&calc();
$("slip").onclick=e=>{const b=e.target.closest("[data-rm]");if(!b)return;slip=slip.filter(i=>i!==+b.dataset.rm);renderSlip();render()};
$("clear").onclick=()=>{slip=[];renderSlip();render()};
$("theme").onclick=()=>{const d=document.documentElement,dark=getComputedStyle(d).getPropertyValue("--bg").trim()==="#0d1218";
 d.dataset.theme=dark?"light":"dark"};
async function load(){
 const n=document.querySelector(".notice");
 try{
  const r=await fetch("/api/props");
  const raw=await r.json();
  if(!r.ok||!Array.isArray(raw))throw new Error((raw&&raw.error)||("HTTP "+r.status));
  props=build(raw);
  n.textContent=props.length?"Live data: lines from The Odds API, game logs from ESPN. Pace, matchup and injury factors are neutral until you add those feeds. Model estimates only, not betting advice.":"Connected, but no props came back (no games or lines available right now).";
 }catch(e){props=[];n.textContent="Could not load live data: "+e.message}
 render();
 if(props.length){sel=props.slice().sort((a,b)=>b.edge-a.edge)[0].id;detail();render()}
}
load();
</script>
</body>
</html>
